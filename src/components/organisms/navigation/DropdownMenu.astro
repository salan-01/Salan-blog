---
import { Icon } from "astro-icon/components";

import { LinkPresets } from "../../../constants/link-presets";
import I18nKey from "../../../i18n/i18nKey";
import { i18n } from "../../../i18n/translation";
import { url } from "../../../utils/url-utils";
import type { DropdownMenuProps } from "./types";

const { link, class: className } = Astro.props as DropdownMenuProps;

const navTitleMap: Record<string, I18nKey> = {
	Links: I18nKey.navLinks,
	My: I18nKey.navMy,
	About: I18nKey.navAbout,
	Others: I18nKey.navOthers,
	Anime: I18nKey.anime,
	Diary: I18nKey.diary,
	Gallery: I18nKey.albums,
	Devices: I18nKey.devices,
	Projects: I18nKey.projects,
	Skills: I18nKey.skills,
	Timeline: I18nKey.timeline,
	Friends: I18nKey.friends,
};

const getLocalizedName = (name: string): string => {
	return name in navTitleMap ? i18n(navTitleMap[name]) : name;
};

const children =
	link.children?.map((child) =>
		typeof child === "number" ? LinkPresets[child] : child,
	) ?? [];

const hasChildren = children.length > 0;
const menuId = `cafe-menu-${link.name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
const descriptions: Record<string, string> = {
	"/about/": "About the host", "/anime/": "On my watchlist",
	"/diary/": "Little everyday moments", "/albums/": "Scenes worth keeping",
	"/devices/": "Tools I use",
};
---

<div class:list={["dropdown-container group", className]} data-dropdown data-nav-paths={JSON.stringify(hasChildren ? children.filter(child => !child.external).map(child => url(child.url)) : link.external ? [] : [url(link.url)])}>
	{
		hasChildren ? (
			<>
				<button
					class="btn-plain scale-animation rounded-lg h-11 font-bold w-11 lg:w-auto lg:px-5 active:scale-95 dropdown-trigger flex items-center justify-center lg:justify-start whitespace-nowrap"
					aria-expanded="false"
					aria-haspopup="true"
					aria-controls={menuId}
					aria-label={getLocalizedName(link.name)}
					data-dropdown-trigger
				>
					{link.icon && (
						<Icon
							name={link.icon}
							class="text-[1.1rem] lg:mr-2 flex-shrink-0"
						/>
					)}
					<span class="truncate hidden lg:inline">
						{getLocalizedName(link.name)}
					</span>
					<Icon
						name="material-symbols:keyboard-arrow-down-rounded"
						class="text-[1.25rem] transition-transform duration-200 dropdown-arrow ml-1 flex-shrink-0 hidden lg:inline"
					/>
				</button>

				<div class="dropdown-menu" data-dropdown-menu id={menuId} inert>
					<div class="dropdown-content">
						<div class="dropdown-heading"><span>Inside the café</span><span aria-hidden="true">✦</span></div>
						{children.map((child) => (
							<a
								href={
									child.external ? child.url : url(child.url)
								}
								target={child.external ? "_blank" : null}
								rel={
									child.external
										? "noopener noreferrer"
										: null
								}
								class="dropdown-item"
								aria-label={child.name}
							>
								<div class="flex items-center">
									{child.icon && (
										<Icon
											name={child.icon}
											class="text-[1rem] mr-2"
										/>
									)}
									<span class="dropdown-copy"><span>{getLocalizedName(child.name)}</span>{descriptions[child.url] && <small>{descriptions[child.url]}</small>}</span>
								</div>
								{child.external && (
									<Icon
										name="fa7-solid:arrow-up-right-from-square"
										class="text-[0.75rem] text-black/25 dark:text-white/25 ml-2"
									/>
								)}
							</a>
						))}
					</div>
				</div>
			</>
		) : (
			<a
				aria-label={link.name}
				href={link.external ? link.url : url(link.url)}
				target={link.external ? "_blank" : null}
				rel={link.external ? "noopener noreferrer" : null}
				class="btn-plain scale-animation rounded-lg h-11 font-bold w-11 lg:w-auto lg:px-5 active:scale-95 flex items-center justify-center lg:justify-start whitespace-nowrap"
			>
				{link.icon && (
					<Icon
						name={link.icon}
						class="text-[1.1rem] lg:mr-2 flex-shrink-0"
					/>
				)}
				<span class="truncate hidden lg:inline">
					{getLocalizedName(link.name)}
				</span>
				{link.external && (
					<Icon
						name="fa7-solid:arrow-up-right-from-square"
						class="text-[0.875rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2] flex-shrink-0 hidden lg:inline"
					/>
				)}
			</a>
		)
	}
</div>

<style>
	@reference "tailwindcss";
	@custom-variant dark (&:where(.dark, .dark *));

	.dropdown-container {
		@apply relative;
	}

	.dropdown-menu {
		@apply absolute top-full left-0 pt-2 opacity-0 invisible pointer-events-none translate-y-[-8px] transition-all duration-200 ease-out z-50;
	}

	.dropdown-trigger[aria-expanded="true"] + .dropdown-menu {
		@apply opacity-100 visible pointer-events-auto translate-y-0;
	}

	.dropdown-trigger[aria-expanded="true"] .dropdown-arrow {
		@apply rotate-180;
	}
	.dropdown-trigger[aria-expanded="false"] + .dropdown-menu {
		opacity: 0; visibility: hidden; pointer-events: none;
	}
	.dropdown-trigger[aria-expanded="false"] .dropdown-arrow { transform: rotate(0); }

	.dropdown-content {
		@apply bg-[var(--float-panel-bg)] rounded-[var(--radius-large)] shadow-xl dark:shadow-none border border-black/5 dark:border-white/10 p-2 min-w-[12rem];
		width: 18rem; background: var(--cafe-surface); border-color: var(--cafe-border);
		box-shadow: 0 20px 50px #593e4c18, 0 1px 0 #ffffff55 inset;
	}
	.dropdown-heading { display: flex; justify-content: space-between; padding: .6rem .8rem .8rem; margin: 0 .3rem .35rem; border-bottom: 1px solid var(--cafe-border); font-size: .7rem; letter-spacing: .08em; color: var(--primary); }
	.dropdown-copy { display: grid; gap: .25rem; }
	.dropdown-copy small { font-size: .7rem; font-weight: 400; color: var(--content-meta); }
	.dropdown-item :global(svg) { flex-shrink: 0; color: var(--primary); margin-right: .8rem; }
	.dropdown-menu { transform-origin: top left; transition: opacity .18s, transform .25s var(--cafe-ease); }
	.dropdown-item { transition: background .18s, color .18s, translate .2s; }
	.dropdown-item:hover { translate: 2px 0; }
	.dropdown-item:focus-visible { outline: 2px solid var(--primary); outline-offset: -2px; }
	.dropdown-item[aria-current="page"] { background: var(--btn-regular-bg); color: var(--primary); }
	@media (prefers-reduced-motion: reduce) { .dropdown-menu, .dropdown-item { transition: none; } .dropdown-item:hover { translate: none; } }

	.dropdown-item {
		@apply flex items-center justify-between px-4 py-2.5 text-black/75 dark:text-white/75 hover:text-[var(--primary)] hover:bg-[var(--btn-plain-bg-hover)] transition-colors duration-150 font-medium rounded-lg;
	}

	@media (width < 768px) {
		.dropdown-container {
			@apply hidden;
		}
	}
</style>

<script>
	function initDropdowns() {
		const dropdowns = document.querySelectorAll("[data-dropdown]");

		dropdowns.forEach((dropdown) => {
			if ((dropdown as HTMLElement).dataset.bound) return;
			(dropdown as HTMLElement).dataset.bound = "true";
			const trigger = dropdown.querySelector(
				"[data-dropdown-trigger]",
			) as HTMLElement;
			const menu = dropdown.querySelector(
				"[data-dropdown-menu]",
			) as HTMLElement;
			const items = dropdown.querySelectorAll(
				".dropdown-item",
			) as NodeListOf<HTMLElement>;

			if (!trigger || !menu) {
				return;
			}

			let leaveTimer: ReturnType<typeof setTimeout>;
			let openedByHover = false;
			const setOpen = (open: boolean) => {
				clearTimeout(leaveTimer);
				trigger.setAttribute("aria-expanded", String(open));
				menu.inert = !open;
			};
			const closeMenu = () => { setOpen(false); openedByHover = false; };

			const toggleMenu = () => {
				const isExpanded =
					trigger.getAttribute("aria-expanded") === "true";
				setOpen(openedByHover || !isExpanded);
				openedByHover = false;
			};
			trigger.addEventListener("click", toggleMenu);
			dropdown.addEventListener("pointerenter", (event) => {
				if ((event as PointerEvent).pointerType === "mouse" && matchMedia("(hover: hover)").matches) { setOpen(true); openedByHover = true; }
			});
			dropdown.addEventListener("pointerleave", () => {
				leaveTimer = setTimeout(() => {
					if (!dropdown.contains(document.activeElement)) closeMenu();
				}, 160);
			});
			dropdown.addEventListener("focusout", () => {
				queueMicrotask(() => { if (!dropdown.contains(document.activeElement)) closeMenu(); });
			});
			items.forEach(item => item.addEventListener("click", closeMenu));

			trigger.addEventListener("keydown", (e) => {
				if (e.key === "ArrowDown" || e.key === "ArrowUp") {
					e.preventDefault();
					openedByHover = false;
					setOpen(true);
					if (items.length > 0) {
						const destination = items[e.key === "ArrowUp" ? items.length - 1 : 0];
						requestAnimationFrame(() => {
							if (trigger.getAttribute("aria-expanded") === "true" && document.activeElement === trigger) destination.focus();
						});
					}
				} else if (e.key === "Escape") {
					closeMenu();
				}
			});

			items.forEach((item, index) => {
				item.addEventListener("keydown", (e) => {
					if (e.key === "ArrowDown") {
						e.preventDefault();
						items[(index + 1) % items.length].focus();
					} else if (e.key === "ArrowUp") {
						e.preventDefault();
						items[
							(index - 1 + items.length) % items.length
						].focus();
					} else if (e.key === "Home" || e.key === "End") {
						e.preventDefault();
						items[e.key === "Home" ? 0 : items.length - 1].focus();
					} else if (e.key === "Escape") {
						e.preventDefault();
						closeMenu();
						trigger.focus();
					}
				});
			});

			document.addEventListener("click", (e) => {
				if (!dropdown.contains(e.target as Node)) {
					closeMenu();
				}
			});
		});
	}
	initDropdowns();
	document.addEventListener("swup:page:view", initDropdowns);
</script>
