---
import { Icon } from "astro-icon/components";

import { navBarConfig, siteConfig } from "../../../config";
import { LinkPresets } from "../../../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../../../types/config";
import { url } from "../../../utils/url-utils";
import LanguageSwitch from "../../control/LanguageSwitch.astro";
import ThemeSwitch from "../../control/ThemeSwitch.svelte";
import SettingsPanel from "../../features/settings/SettingsPanel.svelte";
import MobileTOC from "../../features/toc/MobileTOC.svelte";
import DropdownMenu from "./DropdownMenu.astro";
import NavMenuPanel from "./NavMenuPanel.astro";
import Search from "./Search.svelte";

const className = Astro.props.class;

// 获取导航栏透明模式配置
const navbarTransparentMode =
	siteConfig.banner?.navbar?.transparentMode || "semi";

const isHomePage = Astro.url.pathname === "/" || Astro.url.pathname === "";

// featurePage URL -> config key mapping
const featurePageUrlMap: Record<string, string> = {
	"/anime/": "anime",
	"/diary/": "diary",
	"/friends/": "friends",
	"/albums/": "albums",
	"/devices/": "devices",
};

function isFeaturePageDisabled(url: string): boolean {
	const key = featurePageUrlMap[url];
	if (
		key &&
		!siteConfig.featurePages[key as keyof typeof siteConfig.featurePages]
	) {
		return true;
	}
	return false;
}

function filterLinksByFeaturePages(
	items: (NavBarLink | LinkPreset)[],
): NavBarLink[] {
	return items
		.map((item: NavBarLink | LinkPreset): NavBarLink | null => {
			if (typeof item === "number") {
				const resolved = LinkPresets[item];
				if (isFeaturePageDisabled(resolved.url)) {
					return null;
				}
				return resolved;
			}
			if (isFeaturePageDisabled(item.url)) {
				return null;
			}
			if (item.children) {
				const filteredChildren = filterLinksByFeaturePages(item.children);
				if (filteredChildren.length === 0) {
					return null;
				}
				return { ...item, children: filteredChildren };
			}
			return item;
		})
		.filter((item): item is NavBarLink => item !== null);
}

const links: NavBarLink[] = filterLinksByFeaturePages(navBarConfig.links);

const rawLogo = siteConfig.navbarTitle?.logo;
const logoSrc = rawLogo?.match(/^(http|https|\/\/)/)
	? rawLogo
	: rawLogo
		? url(rawLogo)
		: "";

const rawIcon = siteConfig.navbarTitle?.icon;
const iconSrc = rawIcon?.match(/^(http|https|\/\/)/)
	? rawIcon
	: rawIcon
		? url(rawIcon)
		: "";

const isLogoExternal = rawLogo?.match(/^(http|https|\/\/)/);
const isIconExternal = rawIcon?.match(/^(http|https|\/\/)/);
const hasLogoPngFallback = rawLogo?.endsWith(".png") && !isLogoExternal;
const hasIconPngFallback = rawIcon?.endsWith(".png") && !isIconExternal;
const logoWebpSrc = hasLogoPngFallback
	? logoSrc.replace(/\.png$/i, ".webp")
	: logoSrc;
const iconWebpSrc = hasIconPngFallback
	? iconSrc.replace(/\.png$/i, ".webp")
	: iconSrc;
---
<div id="navbar" class="z-50 onload-animation group" data-transparent-mode={navbarTransparentMode} data-is-home={isHomePage}>
    <div class="absolute h-8 left-0 right-0 -top-8 bg-[var(--card-bg)] transition"></div> <!-- used for onload animation -->
    <div class:list={[className, "cafe-navbar-rail !overflow-visible max-w-[var(--layout-page-width)] h-[4.5rem] mx-auto flex items-center justify-between px-4"]}>
        <a href={url('/')} class="cafe-brand btn-plain scale-animation rounded-lg h-[2.5rem] md:h-[3.25rem] md:[.enable-banner_&]:h-[2.5rem] md:[.enable-banner_&]:group-[.scrolled]:h-[3.25rem] px-2 min-[480px]:px-3 md:px-5 font-bold active:scale-95 shrink-0 transition-all duration-300">
            <div class="flex flex-row items-center text-md">
				{/* 使用navbarTitle配置或默认配置 */}
                {siteConfig.navbarTitle ? (
                    siteConfig.navbarTitle.mode === "logo" ? (
                        hasLogoPngFallback ? (
                            <picture>
                                <source srcset={logoWebpSrc} type="image/webp" />
                                <img src={logoSrc} alt={siteConfig.navbarTitle.text} class="h-[2.5rem] md:h-[3.25rem] md:[.enable-banner_&]:h-[2.5rem] md:[.enable-banner_&]:group-[.scrolled]:h-[3.25rem] max-w-full object-contain transition-all duration-300" loading="lazy" />
                            </picture>
                        ) : (
                            <img src={logoSrc} alt={siteConfig.navbarTitle.text} class="h-[2.5rem] md:h-[3.25rem] md:[.enable-banner_&]:h-[2.5rem] md:[.enable-banner_&]:group-[.scrolled]:h-[3.25rem] max-w-full object-contain transition-all duration-300" loading="lazy" />
                        )
                    ) : (
                        <>
                            {hasIconPngFallback ? (
                                <picture>
                                    <source srcset={iconWebpSrc} type="image/webp" />
                                    <img src={iconSrc} alt="" class="h-[1.75rem] w-[1.75rem] mr-2 object-contain" loading="lazy" />
                                </picture>
                            ) : (
                                <img src={iconSrc} alt="" class="h-[1.75rem] w-[1.75rem] mr-2 object-contain" loading="lazy" />
                            )}
                            <span class="cafe-brand-name hidden min-[480px]:inline dark:text-white text-black">{siteConfig.navbarTitle.text}</span>
                        </>
                    )
                ) : (
                    <>
                        <Icon name="material-symbols:home-pin-outline" class="text-[1.75rem] mr-2" />
                        <span class="dark:text-white text-black">{siteConfig.title}</span>
                    </>
                )}
            </div>
        </a>
        <div id="navbar-links-container" class="hidden md:flex items-center space-x-1 transition-opacity duration-300">
            <span class="cafe-nav-indicator" aria-hidden="true"></span>
            {links.map((l) => {
                return <DropdownMenu link={l} />;
            })}
        </div>
        <div class="flex items-center gap-0 min-[480px]:gap-1">
            <div id="search-container">
                <Search client:only="svelte"></Search>
            </div>
            {/* 只在 sidebar 模式下显示移动端 TOC 按钮 */}
            {siteConfig.toc.enable && siteConfig.toc.mobileTop && <MobileTOC client:only="svelte"></MobileTOC>}
            <LanguageSwitch />
            <button aria-label="Display Settings" class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="display-settings-switch">
                <Icon name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
            </button>
            <ThemeSwitch client:only="svelte"></ThemeSwitch>
            <button aria-label="Menu" name="Nav Menu" class="btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90 md:!hidden" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
            </button>
        </div>
        <NavMenuPanel links={links}></NavMenuPanel>
        <SettingsPanel client:only="svelte"></SettingsPanel>
    </div>
</div>

<script>
	const navRail = document.getElementById("navbar-links-container");
	const indicator = navRail?.querySelector<HTMLElement>(".cafe-nav-indicator");
	const normalizePath = (path: string) => path.replace(/\/+$/, "") || "/";
	function placeIndicator(item: Element | null) {
		if (!navRail || !indicator) return;
		if (!item || !navRail.offsetWidth) { indicator.style.opacity = "0"; return; }
		const rect = item.getBoundingClientRect();
		indicator.style.width = `${rect.width}px`;
		indicator.style.translate = `${rect.left - navRail.getBoundingClientRect().left}px 0`;
		indicator.style.opacity = "1";
	}
	function syncNavigation() {
		const path = normalizePath(location.pathname);
		navRail?.querySelectorAll<HTMLElement>("[data-nav-paths]").forEach(item => {
			const paths = JSON.parse(item.dataset.navPaths || "[]") as string[];
			item.dataset.navActive = String(paths.some(route => normalizePath(route) === path || (normalizePath(route) === "/archive" && path.startsWith("/posts/"))));
		});
		document.querySelectorAll<HTMLAnchorElement>("#navbar-links-container a[href], #nav-menu-panel a[href]").forEach(link => {
			if (link.origin === location.origin && normalizePath(link.pathname) === path) link.setAttribute("aria-current", "page");
			else link.removeAttribute("aria-current");
		});
		placeIndicator(navRail?.querySelector('[data-nav-active="true"]') || null);
	}
	navRail?.querySelectorAll<HTMLElement>("[data-nav-paths]").forEach(item => {
		item.addEventListener("pointerenter", event => { if (event.pointerType === "mouse") placeIndicator(item); });
		item.addEventListener("focusin", () => placeIndicator(item));
	});
	navRail?.addEventListener("pointerleave", syncNavigation);
	navRail?.addEventListener("focusout", () => queueMicrotask(() => { if (!navRail.contains(document.activeElement)) syncNavigation(); }));
	if (navRail) new ResizeObserver(syncNavigation).observe(navRail);
	document.addEventListener("swup:page:view", syncNavigation);
	document.addEventListener("mizuki:language-changed", () => requestAnimationFrame(syncNavigation));
	syncNavigation();

	const cardObserver = new IntersectionObserver(entries => {
		for (const entry of entries) if (entry.isIntersecting) {
			entry.target.classList.add("cafe-card-enter");
			cardObserver.unobserve(entry.target);
		}
	}, { threshold: .12 });
	function revealCards() {
		if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
		document.querySelectorAll<HTMLElement>(".cafe-post-card:not([data-cafe-observed])").forEach(card => { card.dataset.cafeObserved = "true"; cardObserver.observe(card); });
	}
	revealCards();
	document.addEventListener("swup:page:view", revealCards);

	// Search expansion now controls navigation visibility, not pointer hover.

function loadButtonScript() {
    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            let settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                settingPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                menuPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    document.addEventListener("click", function(event) {
        const panels = ["display-setting", "nav-menu-panel"];
        const buttons = ["display-settings-switch", "nav-menu-switch"];
        panels.forEach((id, index) => {
            const panel = document.getElementById(id);
            const button = document.getElementById(buttons[index]);
            if (panel && button && !panel.classList.contains("float-panel-closed")) {
                if (event.target instanceof Node && !panel.contains(event.target) && !button.contains(event.target)) {
                    panel.classList.add("float-panel-closed");
                }
            }
        });
    });
}

loadButtonScript();

// 为semifull模式添加滚动检测逻辑
function initSemifullScrollDetection() {
    const navbar = document.getElementById('navbar');
    if (!navbar) {return;}
    
    // 移除之前的滚动事件监听器（如果存在）
    // @ts-ignore
    if (window.semifullScrollHandler) {
        // @ts-ignore
        window.removeEventListener('scroll', window.semifullScrollHandler);
    }
    
    // 获取当前是否为首页
    // @ts-ignore
    const isHomePage = navbar.dataset.isHome === 'true';

    // 如果不是首页，在平板/桌面端强制显示为scrolled状态
    if (!isHomePage) {
        navbar.classList.add('scrolled');
        return;
    }
    
    let ticking = false;
    
    function updateNavbarState() {
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const threshold = 50; // 滚动阈值，可以根据需要调整
        
        if (navbar && scrollTop > threshold) {
            navbar.classList.add('scrolled');
        } else if (navbar) {
            navbar.classList.remove('scrolled');
        }
        
        ticking = false;
    }
    
    function requestTick() {
        if (!ticking) {
            requestAnimationFrame(updateNavbarState);
            ticking = true;
        }
    }
    
    // 保存新的事件处理器引用
    // @ts-ignore
    window.semifullScrollHandler = requestTick;
    
    // 监听滚动事件
    window.addEventListener('scroll', requestTick, { passive: true });
    
    // 初始化状态
    updateNavbarState();
}

// 将函数暴露到全局对象，供页面切换时调用
// @ts-ignore
window.initSemifullScrollDetection = initSemifullScrollDetection;

// 页面加载完成后初始化滚动检测
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSemifullScrollDetection);
} else {
    initSemifullScrollDetection();
}
</script>

<script is:inline>
window.loadPagefind = async function() {
    if (window.pagefind) {return;}
    try {
        const scriptUrl = new URL('pagefind/pagefind.js', window.location.origin).href;
        const response = await fetch(scriptUrl, { method: 'HEAD' });
        if (!response.ok) {
            throw new Error(`Pagefind script not found: ${response.status}`);
        }

        const pagefind = await import(scriptUrl);

        await pagefind.options({
            excerptLength: 20
        });

        window.pagefind = pagefind;

        document.dispatchEvent(new CustomEvent('pagefindready'));
        console.log('Pagefind loaded and initialized successfully, event dispatched.');
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        // Do not cache a fake empty index: a later retry must be able to load it.
        delete window.pagefind;
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
        console.log('Pagefind load error, event dispatched.');
    }
};
</script>
