---
import * as fs from "node:fs";
import * as path from "node:path";

import { footerConfig } from "../../../config";
import { url } from "../../../utils/url-utils";
import Calendar from "../../widgets/calendar/Calendar.astro";
import SiteStats from "../../widgets/site-stats/SiteStats.astro";

const currentYear = new Date().getFullYear();

// 页脚自定义内容逻辑
let customFooterHtml = "";
if (footerConfig.enable) {
	// 优先使用 customHtml，如果为空则使用 FooterConfig.html 文件内容
	if (footerConfig.customHtml && footerConfig.customHtml.trim() !== "") {
		customFooterHtml = footerConfig.customHtml.trim();
	} else {
		// customHtml 为空时，读取 FooterConfig.html 文件内容
		try {
			const footerConfigPath = path.join(
				process.cwd(),
				"src",
				"FooterConfig.html",
			);
			customFooterHtml = fs.readFileSync(footerConfigPath, "utf-8");
			// 移除HTML注释
			customFooterHtml = customFooterHtml
				.replace(/<!--[\s\S]*?-->/g, "")
				.trim();
		} catch (error) {
			console.warn(
				"FooterConfig.html文件读取失败:",
				error instanceof Error ? error.message : error,
			);
		}
	}
}
---

<details class="footer-insights">
	<summary>
		<span><strong>喫茶店資訊</strong><small>站點統計與文章日曆</small></span>
		<span class="insights-arrow" aria-hidden="true">⌄</span>
	</summary>
	<div class="footer-insights-grid">
		<SiteStats />
		<Calendar showOnMobile />
	</div>
</details>

<style>
	.footer-insights { margin-top: 2rem; border: 1px solid var(--line-divider); border-radius: 1rem; background: var(--card-bg); }
	.footer-insights summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.1rem 1.4rem; cursor: pointer; list-style: none; color: var(--btn-content); }
	.footer-insights summary::-webkit-details-marker { display: none; }
	.footer-insights summary:focus-visible { outline: 2px solid var(--btn-content); outline-offset: -4px; border-radius: 1rem; }
	.footer-insights strong { display: block; font-size: .95rem; }
	.footer-insights small { display: block; margin-top: .25rem; font-size: .8rem; color: var(--content-meta); }
	.insights-arrow { font-size: 1.3rem; transition: transform .2s; }
	.footer-insights[open] .insights-arrow { transform: rotate(180deg); }
	.footer-insights-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; padding: 0 1rem 1rem; }
	@media (max-width: 767px) { .footer-insights-grid { grid-template-columns: minmax(0, 1fr); } }
	@media (prefers-reduced-motion: reduce) { .insights-arrow { transition: none; } }
</style>

<footer class="cafe-footer">
	{customFooterHtml && <div class="cafe-footer-custom" set:html={customFooterHtml} />}
	<div class="cafe-footer-flourish" aria-hidden="true"><span></span>✦<span></span></div>
	<a class="cafe-footer-brand" href={url("/")}>Salan's Café</a>
	<p class="cafe-footer-copyright">&copy; <span id="copyright-year">{currentYear}</span> Salan's Café</p>
	<nav class="cafe-footer-links" aria-label="Feeds and sitemap">
		<a href={url("rss/")}>RSS</a>
		<a href={url("atom/")}>Atom</a>
		<a href={url("sitemap-index.xml")} data-no-swup>Sitemap</a>
	</nav>
</footer>

<style>
	.cafe-footer { display: flex; flex-direction: column; align-items: center; gap: .75rem; padding: 2.5rem 1rem 3rem; text-align: center; color: var(--content-meta); }
	.cafe-footer-flourish { display: flex; align-items: center; gap: 1rem; color: var(--primary); font-size: .8rem; }
	.cafe-footer-flourish span { height: 1px; width: 3rem; background: linear-gradient(90deg, transparent, var(--primary)); opacity: .35; }
	.cafe-footer-flourish span:last-child { transform: rotate(180deg); }
	.cafe-footer-brand { color: var(--content-meta); font-size: 1.1rem; letter-spacing: .04em; }
	.cafe-footer-copyright { margin: 0; font-size: .75rem; }
	.cafe-footer-links { display: flex; align-items: center; justify-content: center; gap: .5rem; font-size: .75rem; }
	.cafe-footer-links a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 .6rem; border-radius: .5rem; }
	.cafe-footer a:hover { color: var(--primary); }
	.cafe-footer a:focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }
</style>
