---
interface Props { isHome: boolean; }
const { isHome } = Astro.props;
---

<section id="cinematic-story" aria-label="Salanの喫茶店" data-no-translate>
	<div class="story-stage">
		<div class="story-atmosphere" aria-hidden="true"></div>
		<div class="story-blush" aria-hidden="true"></div>
		<div class="story-grid" aria-hidden="true"></div>
		<div class="story-halo" aria-hidden="true"></div>
		<div class="story-slash" aria-hidden="true"></div>
		<div class="story-wordmark" aria-hidden="true">SALAN</div>
		<canvas class="story-particles" aria-hidden="true"></canvas>
		<div class="story-character" aria-hidden="true">
			<picture>
				<img src="/assets/story/cafe-cutout-complete.webp" alt="" width="1122" height="1402" loading={isHome ? "eager" : "lazy"} fetchpriority={isHome ? "high" : "low"} decoding="async" />
			</picture>
		</div>
		<div class="story-shade" aria-hidden="true"></div>
		<canvas class="story-particles-front" aria-hidden="true"></canvas>
		<div class="story-petals" aria-hidden="true"><i></i><i></i><i></i></div>
		<div class="story-edition" aria-hidden="true"><span>✦</span> SALAN’S CAFÉ <span class="story-edition-line"></span> PERSONAL WORLD / 01</div>
		<div class="story-copy story-intro">
			<p class="story-eyebrow"><b>01</b><span data-zh="日常，也能成為主角" data-en="MAKE EVERY DAY A MAIN STORY">日常，也能成為主角</span></p>
			<h1><span data-zh="Salanの" data-en="Salan’s">Salanの</span><br /><span class="story-accent" data-zh="喫茶店" data-en="Café.">喫茶店</span></h1>
			<p class="story-description" data-zh="把熱愛寫進生活。這裡是 Salanの喫茶店。" data-en="A little passion in every day. Welcome to Salan’s Café.">把熱愛寫進生活。這裡是 Salanの喫茶店。</p>
			<div class="story-tags"><span data-zh="生活" data-en="LIFE">生活</span><span data-zh="技術" data-en="TECH">技術</span><span data-zh="靈感" data-en="IDEAS">靈感</span></div>
		</div>
		<div class="story-copy story-middle" aria-hidden="true">
			<p class="story-eyebrow"><b>02</b><span data-zh="好奇心，永不退場" data-en="CURIOSITY NEVER FADES">好奇心，永不退場</span></p>
			<h2><span data-zh="保持熱愛，" data-en="STAY CURIOUS.">保持熱愛，</span><br /><span class="story-accent" data-zh="探索不設限。" data-en="GO BEYOND.">探索不設限。</span></h2>
			<p class="story-description" data-zh="新知識、新靈感，還有每個值得記住的小發現。" data-en="New ideas, new discoveries, and little moments worth remembering.">新知識、新靈感，還有每個值得記住的小發現。</p>
		</div>
		<div class="story-copy story-outro" aria-hidden="true">
			<p class="story-eyebrow"><b>03</b><span data-zh="下一頁，一起出發" data-en="THE NEXT CHAPTER IS YOURS">下一頁，一起出發</span></p>
			<h2><span data-zh="你的到來，" data-en="HELLO THERE.">你的到來，</span><br /><span class="story-accent" data-zh="讓故事繼續。" data-en="LET’S BEGIN.">讓故事繼續。</span></h2>
			<p class="story-description" data-zh="生活的片段、技術的筆記，都在下一頁等你。" data-en="Life stories and technology notes are waiting just below.">生活的片段、技術的筆記，都在下一頁等你。</p>
		</div>
		<nav class="story-chapters" aria-label="捲動章節">
			<button type="button" data-scene="0" aria-current="step"><b>01</b><span data-zh="開場" data-en="INTRO">開場</span></button>
			<button type="button" data-scene="0.46"><b>02</b><span data-zh="探索" data-en="EXPLORE">探索</span></button>
			<button type="button" data-scene="0.93"><b>03</b><span data-zh="啟程" data-en="BEGIN">啟程</span></button>
		</nav>
		<div class="story-bottom">
			<div class="story-scroll"><span class="story-scroll-line"></span><span data-zh="向下捲動，展開故事" data-en="SCROLL TO EXPLORE">向下捲動，展開故事</span></div>
			<button class="story-skip" type="button"><span data-zh="進入喫茶店" data-en="ENTER THE CAFÉ">進入喫茶店</span><span aria-hidden="true">↗</span></button>
		</div>
		<div class="story-progress" aria-hidden="true"><i></i></div>
	</div>
</section>

<script>
	import { storyFrame } from "../../utils/cinematic-timeline";
	import { createCafeParticles } from "../../utils/cafe-particles";
	const story = document.getElementById("cinematic-story")!;
	story.dataset.ready = "true";
	const stage = story.querySelector<HTMLElement>(".story-stage")!;
	const particles = createCafeParticles(
		story.querySelector<HTMLCanvasElement>(".story-particles")!,
		story.querySelector<HTMLCanvasElement>(".story-particles-front")!,
	);
	const intro = story.querySelector<HTMLElement>(".story-intro")!;
	const middle = story.querySelector<HTMLElement>(".story-middle")!;
	const outro = story.querySelector<HTMLElement>(".story-outro")!;
	const reduced = matchMedia("(prefers-reduced-motion: reduce)");
	const mobile = matchMedia("(max-width: 767px)");
	let pending = 0;
	let visible = true;
	const finePointer = matchMedia("(hover: hover) and (pointer: fine)");
	let pointerX = 0;
	let pointerY = 0;

	function renderStory() {
		pending = 0;
		const active = document.documentElement.dataset.layoutVariant === "home" && document.body.classList.contains("enable-banner");
		const rect = story.getBoundingClientRect();
		document.documentElement.dataset.storyFocus = String(active && rect.bottom > 100);
		const p = reduced.matches ? 0 : -rect.top / Math.max(1, rect.height - stage.offsetHeight);
		const state = storyFrame(p, mobile.matches);
		particles.update({ ...state, pointerX, pointerY, width:stage.clientWidth, height:stage.clientHeight,
			mobile:mobile.matches, reduced:reduced.matches, active:active && visible && !document.hidden });
		if (!active) return;
		stage.style.setProperty("--pointer-x", String(pointerX));
		stage.style.setProperty("--pointer-y", String(pointerY));
		for (const [key, value] of Object.entries(state)) stage.style.setProperty(`--story-${key}`, String(value));
		intro.setAttribute("aria-hidden", String(state.intro < 0.1));
		middle.setAttribute("aria-hidden", String(state.middle < 0.1));
		outro.setAttribute("aria-hidden", String(state.outro < 0.1));
		const chapter = state.progress < 0.3 ? 0 : state.progress < 0.7 ? 1 : 2;
		stage.dataset.chapter = String(chapter);
		story.querySelectorAll("[data-scene]").forEach((button, index) => {
			if (index === chapter) button.setAttribute("aria-current", "step");
			else button.removeAttribute("aria-current");
		});
	}
	function schedule() { if (!pending) pending = requestAnimationFrame(renderStory); }
	const observer = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; schedule(); });
	observer.observe(story);
	new ResizeObserver(schedule).observe(story);
	new MutationObserver(schedule).observe(document.documentElement, { attributes: true, attributeFilter: ["data-layout-variant"] });
	new MutationObserver(schedule).observe(document.body, { attributes: true, attributeFilter: ["class"] });
	window.addEventListener("scroll", () => { if (visible && !document.hidden) schedule(); }, { passive: true });
	window.addEventListener("resize", schedule, { passive: true });
	stage.addEventListener("pointermove", event => {
		if (!finePointer.matches || reduced.matches || event.pointerType !== "mouse") return;
		pointerX = (event.clientX / stage.clientWidth - .5) * 2;
		pointerY = (event.clientY / stage.clientHeight - .5) * 2;
		schedule();
	});
	stage.addEventListener("pointerleave", () => { pointerX = 0; pointerY = 0; schedule(); });
	reduced.addEventListener("change", schedule);
	document.addEventListener("visibilitychange", schedule);
	document.addEventListener("swup:page:view", schedule);
	story.querySelectorAll<HTMLElement>("[data-scene]").forEach(button => button.addEventListener("click", () => {
		const top = story.getBoundingClientRect().top + scrollY;
		window.scrollTo({ top: top + Number(button.dataset.scene) * (story.offsetHeight - stage.offsetHeight), behavior: "instant" });
	}));
	story.querySelector(".story-skip")!.addEventListener("click", () => {
		const content = document.getElementById("blog-content");
		if (content) {
			window.scrollTo({ top: content.getBoundingClientRect().top + window.scrollY - 90, behavior: reduced.matches ? "instant" : "smooth" });
			const firstLink = content.querySelector<HTMLElement>("#content-wrapper a[href]");
			firstLink?.focus({ preventScroll: true });
		}
	});
	function language() {
		const en = document.documentElement.lang === "en";
		for (const node of story.querySelectorAll<HTMLElement>("[data-zh]")) node.textContent = (en ? node.dataset.en : node.dataset.zh) || "";
	}
	document.addEventListener("mizuki:language-changed", language);
	language();
	renderStory();
</script>

<style is:global>
	/* The story is persistent like the navbar; only the home banner mode reveals it. */
	#cinematic-story { display: none; }
	html[data-layout-variant="home"] .enable-banner #cinematic-story { display: block; }
	html[data-layout-variant="home"] .enable-banner #banner-wrapper { display: none !important; }
	html[data-layout-variant="home"] .enable-banner #top-row {
		position: fixed; top: 0; left: 0; right: 0; width: 100%; height: auto !important;
	}
	html[data-layout-variant="home"] .enable-banner #blog-content { position: relative !important; top: 0 !important; padding-top: 2rem; background:#fffaf6; }
	html.dark[data-layout-variant="home"] .enable-banner #blog-content { background:#241d26; }
	html[data-layout-variant="home"] .enable-banner #main-grid { transform: none !important; }
	html[data-layout-variant="home"] .enable-banner :is(#sidebar-sticky, #left-sidebar-sticky, #right-sidebar-sticky) { top: 6rem !important; }
	html[data-layout-variant="home"] .enable-banner .top-gradient-highlight { display: none; }
	html[data-story-focus="true"] #navbar-wrapper { opacity: 1 !important; transform: none !important; translate: none !important; }
	html[data-story-focus="true"] #navbar > div { background: #fffaf5e6 !important; border: 0 !important; box-shadow: 0 1px 0 #b8768a1a !important; backdrop-filter: blur(16px); }
	html[data-story-focus="true"] #navbar > div > a,
	html[data-story-focus="true"] #navbar > div > a span,
	html[data-story-focus="true"] #navbar-links-container > div > a,
	html[data-story-focus="true"] #navbar-links-container > div > button,
	html[data-story-focus="true"] #navbar :is(#language-switch, #display-settings-switch, #scheme-switch, #nav-menu-switch, #search-switch, #search-bar, #mobile-toc-switch) { color: #543d48 !important; }
	html[data-story-focus="true"] #navbar .btn-plain { background: transparent !important; }
	html[data-story-focus="true"] #navbar .btn-plain::before { background: transparent !important; }
	html[data-story-focus="true"] #navbar .btn-plain:is(:hover, :focus-visible, [aria-expanded="true"])::before { background: #e89aad26 !important; }
	html[data-banner-title-enabled="false"] .story-copy { display: none; }
	#cinematic-story { position: relative; height: 100svh; background: #fff8f1; color: #493842; }
	#cinematic-story[data-ready="true"] { height: 340svh; }
	.story-stage { position: sticky; top: 0; height: 100svh; min-height: 560px; overflow: clip; isolation: isolate; --story-intro: 1; --story-middle: 0; --story-outro: 0; --story-progress: 0; --story-scale: 1.12; --story-x: 22; --story-y: 8; --story-rotation: -3; --story-palette: 0; }
	.story-atmosphere, .story-blush, .story-grid, .story-shade, .story-particles, .story-particles-front { position: absolute; inset: 0; pointer-events: none; }
	.story-particles, .story-particles-front { width:100%; height:100%; }
	.story-atmosphere { background: linear-gradient(90deg, #fffaf2df, #fff4ed80 48%, #ffe9e833), url("/assets/story/cafe-magic-room.webp") center / cover no-repeat; transform: scale(1.06) translateY(calc(var(--story-progress) * -2svh)); }
	.story-blush { background: radial-gradient(ellipse at 28% 40%, #f5c4d070, transparent 64%), linear-gradient(90deg, #fff0f222, #fff5f0d9); opacity: var(--story-palette); }
	.story-grid { background-image: linear-gradient(#b8768a09 1px, transparent 1px), linear-gradient(90deg, #b8768a09 1px, transparent 1px); background-size: 64px 64px; transform: perspective(600px) rotateX(15deg) scale(1.3) translateY(calc(var(--story-progress) * -70px)); }
	.story-grid { opacity:.35; }
	.story-slash { position: absolute; width: 35vw; height: 150%; top: -20%; right: 12%; transform: skewX(-22deg) translateX(calc(var(--story-palette) * -30vw)); border-inline: 1px solid #ffffffd9; background: linear-gradient(180deg, #f8cad540, #efb6c67d, #ffdacc50); }
	.story-slash { opacity:.45; }
	.story-wordmark { position: absolute; left: -2%; bottom: 1%; font: 900 27vw/.85 Arial, sans-serif; letter-spacing: -.09em; -webkit-text-stroke: 1px #bc7b9229; color: transparent; transform: translateX(calc(var(--story-progress) * -9vw)); user-select: none; }
	/* Keep the complete raised hand below the fixed navigation throughout the camera path. */
	.story-character { position: absolute; left: 50%; top: max(80px, 8svh); height: 110svh; aspect-ratio: 1122 / 1402; transform-origin: 50% 0; transform: translateX(calc(-50% + var(--story-x) * 1vw)) translateY(calc(var(--story-y) * 1vh)) scale(var(--story-scale)) rotate(calc(var(--story-rotation) * 1deg)); will-change: transform; filter: drop-shadow(0 12px 24px #ac6a7926); }
	.story-character picture {
		display: block;
		width: 100%;
		height: 100%;
		-webkit-mask-image: linear-gradient(to bottom, #000 76%, #000000e6 86%, transparent 99%);
		mask-image: linear-gradient(to bottom, #000 76%, #000000e6 86%, transparent 99%);
	}
	.story-character img { width: 100%; height: 100%; object-fit: contain; }
	/* Separate the foreground response from the reversible scroll camera. */
	.story-character picture { transform:translate3d(calc(var(--pointer-x,0) * 12px),calc(var(--pointer-y,0) * 9px),0); transition:transform .5s cubic-bezier(.22,1,.36,1); }
	.story-halo { position:absolute; inset:10% 1% 2% 44%; pointer-events:none; background:radial-gradient(ellipse,#fff5ce70,transparent 65%); mix-blend-mode:screen; transform:translate3d(calc(var(--pointer-x,0) * -18px),calc(var(--pointer-y,0) * -12px),0); transition:transform .5s; }
	.story-copy.story-intro h1 { font-size:clamp(80px,9vw,150px); line-height:1.02; letter-spacing:-.06em; }
	.story-intro .story-accent { background-image:linear-gradient(115deg,#b43d6c,#d67591 50%,#be6268); }
	@media (min-width:768px) { .story-character { height:88svh; top:max(80px,8svh); } .story-copy.story-intro { top:25%; } .story-edition { top:15%; } }
	.story-shade { background: linear-gradient(0deg, #fff8f1f2, transparent 35%); }
	.story-edition { position: absolute; left: 7%; right: 7%; top: 17%; display: flex; align-items: center; gap: 12px; font: 500 10px/1.4 var(--font-sans); letter-spacing: .22em; color: #86606b; }
	.story-edition > span:first-child { font-size: 22px; color: #b85d7b; }
	.story-edition-line { width: 60px; height: 1px; background: #b87b8d60; }
	@media (min-width: 768px) { .story-edition { opacity: calc(1 - var(--story-palette)); } }
	.story-copy { position: absolute; left: 7%; top: 30%; width: 46%; max-width: 740px; transform: translateY(calc((1 - var(--story-intro)) * -65px)); opacity: var(--story-intro); will-change: transform, opacity; pointer-events: none; }
	.story-copy h1, .story-copy h2 { font-family: var(--font-sans); font-size: clamp(48px, 6.1vw, 100px); font-weight: 500; font-synthesis: none; line-height: 1.22; letter-spacing: -0.025em; color: #493842; margin: 22px 0; text-shadow: 0 4px 30px #ffffff80; }
	.story-eyebrow { display: flex; align-items: center; gap: 12px; font-size: 11px; font-weight: 600; letter-spacing: .2em; color: #805562; }
	.story-eyebrow b { border: 1px solid #bf6b8650; padding: 5px 7px; font: 500 11px/1 var(--font-sans); color: #a54a68; }
	.story-accent { background: linear-gradient(110deg, #ba4e70, #c55e76 50%, #b65d4b); background-clip: text; -webkit-text-fill-color: transparent; }
	.story-description { font-size: clamp(14px, 1.2vw, 18px); line-height: 1.8; color: #72545c; max-width: 430px; }
	.story-tags { display: flex; gap: 20px; margin-top: 26px; font-size: 10px; letter-spacing: .2em; color: #805b68; }
	.story-tags span::before { content: "+"; margin-right: 8px; color: #b25273; }
	.story-middle { left: 53%; width: 42%; opacity: var(--story-middle); transform: translateY(calc((1 - var(--story-middle)) * 45px)); }
	.story-middle .story-accent { background-image: linear-gradient(110deg, #aa496e, #b85981 70%, #bf6174); }
	.story-outro { opacity: var(--story-outro); transform: translateY(calc((1 - var(--story-outro)) * 35px)); }
	.story-chapters { position: absolute; left: 43%; bottom: 8.5%; display: flex; gap: 24px; }
	.story-chapters button { display: flex; align-items: center; gap: 8px; color: #7c5b68; font-size: 11px; cursor: pointer; letter-spacing: .15em; padding: 5px; min-height:44px; min-width:44px; justify-content:center; }
	.story-chapters b { font: 500 11px var(--font-sans); writing-mode: horizontal-tb; }
	.story-chapters button[aria-current] { color: #a44265; border-bottom: 1px solid #b95e7c; }
	.story-bottom { position: absolute; left: 7vw; right: 7vw; bottom: 6%; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
	.story-scroll { display: flex; align-items: center; gap: 15px; font-size: 10px; color: #805b68; letter-spacing: .15em; }
	.story-scroll-line { width: 34px; height: 1px; background: #bc6b83; }
	.story-skip { display: inline-flex; align-items: center; gap: 40px; color: #fffaf7; font-size: 13px; font-weight: 700; background: linear-gradient(110deg, #ad476c, #b84f6a); padding: 17px 28px; cursor: pointer; clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px); }
	.story-skip:hover { background: #983b5d; }
	.story-skip:focus-visible, .story-chapters button:focus-visible { outline: 2px solid #493842; outline-offset: -4px; }
	.story-progress { position: absolute; bottom: 0; left: 0; right: 0; height: 2px; background: #80645715; }
	.story-progress i { display: block; height: 100%; background: #c87590; transform: scaleX(var(--story-progress)); transform-origin: left; }
	.story-petals { display: none; }
	@media (max-width: 767px) {
		html[data-layout-variant="home"] .enable-banner #blog-content { padding-top:1.25rem; }
		#cinematic-story[data-ready="true"] { height: 310svh; }
		.story-stage { min-height: 600px; --story-scale: 1.18; --story-x: 16; --story-y: -2; }
		.story-edition { top: 10%; font-size: 8px; letter-spacing: .12em; }
		.story-edition-line { width: 18px; }
		.story-character { top: 13%; height:auto; width:92%; aspect-ratio:1122 / 1402; transform-origin:50% 25%; transform:translateX(calc(-50% + var(--story-x) * .1vw)) translateY(calc(var(--story-y) * .6vh)) scale(calc(var(--story-scale) * .82)) rotate(calc(var(--story-rotation) * 1deg)); }
		/* Feather the asset's cropped skirt with the moving artwork, not the viewport. */
		.story-character picture {
			-webkit-mask-image: linear-gradient(to bottom, #000 74%, #000000e0 82%, transparent 99%);
			mask-image: linear-gradient(to bottom, #000 74%, #000000e0 82%, transparent 99%);
		}
		.story-slash { width: 65vw; right: 8%; transform: skewX(-22deg) translate3d(calc(var(--story-palette) * -18vw), calc(var(--story-progress) * 6svh), 0); }
		.story-wordmark { bottom: 38%; font-size: 43vw; transform: translate3d(calc(var(--story-progress) * -36vw), calc(var(--story-progress) * -12svh), 0); }
		.story-petals { display: block; position: absolute; inset: 0; pointer-events: none; opacity:.35; }
		.story-petals i { position: absolute; width: 48px; height: 24px; border-radius: 80% 0 80% 10%; background: linear-gradient(120deg, #fff8f1e6, #eaa5b3b3); box-shadow: inset 0 0 0 1px #fff8f180; }
		.story-petals i:nth-child(1) { left: -5%; top: 35%; filter: blur(1px); transform: translate3d(calc(var(--story-progress) * 22vw), calc(var(--story-progress) * -32svh), 0) rotate(calc(-35deg + var(--story-progress) * 140deg)); }
		.story-petals i:nth-child(2) { right: 1%; top: 64%; width: 64px; height: 32px; filter: blur(2px); transform: translate3d(calc(var(--story-progress) * -12vw), calc(var(--story-progress) * -48svh), 0) rotate(calc(25deg - var(--story-progress) * 160deg)); }
		.story-petals i:nth-child(3) { left: 17%; top: 23%; width: 20px; height: 10px; opacity: .65; transform: translate3d(calc(var(--story-progress) * 30vw), calc(var(--story-progress) * 12svh), 0) rotate(calc(var(--story-progress) * 180deg)); }
		.story-shade { background: linear-gradient(0deg, #fff8f1 6%, #fff8f1fa 22%, #fff8f1bf 37%, transparent 58%); }
		.story-copy, .story-middle { left: 7%; top: auto; bottom: 17%; width: 86%; }
		.story-intro { transform: translate3d(calc((1 - var(--story-intro)) * -32px), calc((1 - var(--story-intro)) * -24px), 0); }
		.story-middle { transform: translate3d(calc((1 - var(--story-middle)) * 32px), calc((1 - var(--story-middle)) * 20px), 0); }
		.story-outro { transform: translate3d(0, calc((1 - var(--story-outro)) * 48px), 0) scale(calc(.96 + var(--story-outro) * .04)); transform-origin: left bottom; }
		.story-copy h1, .story-copy h2 { font-size: clamp(36px, 10.6vw, 64px); margin: 12px 0; }
		.story-eyebrow { font-size: 9px; letter-spacing: .12em; }
		.story-description { font-size: 12px; max-width: 310px; }
		.story-tags { margin-top: 14px; font-size: 9px; }
		.story-chapters { top: 18%; right: 3%; bottom: auto; left: auto; display: grid; gap: 4px; }
		.story-chapters button { font-size: 8px; min-width: 44px; min-height: 44px; justify-content: center; }
		.story-chapters button span { display: none; }
		.story-scroll { font-size: 9px; max-width: 90px; gap: 8px; }
		.story-scroll-line { width: 16px; flex-shrink: 0; }
		.story-bottom { right: 5.5rem; gap: 12px; bottom: 5%; }
