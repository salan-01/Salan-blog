---

<button
	id="language-switch"
	type="button"
	class="btn-plain scale-animation rounded-lg h-11 w-11 px-0 active:scale-90 flex items-center justify-center gap-0"
	aria-label="Switch to English"
	title="Switch to English"
>
	<Icon name="material-symbols:language" class="text-[1.25rem]" />
	<span id="language-switch-label" class="text-xs font-bold leading-none">EN</span>
</button>

<script is:inline define:vars={{ translationPairs }}>
	const STORAGE_KEY = "mizuki-language";
	const zhToEn = new Map(translationPairs);
	const enToZh = new Map(translationPairs.map(([traditionalChinese, english]) => [english, traditionalChinese]));
	const ignoredElements = new Set(["SCRIPT", "STYLE", "NOSCRIPT", "CODE", "PRE", "TEXTAREA"]);
	let currentLanguage = localStorage.getItem(STORAGE_KEY) === "zh_TW" ? "zh_TW" : "en";
	let isApplyingLanguage = false;

	function translateValue(value, targetLanguage) {
		const trimmed = value.trim();
		if (!trimmed) return value;
		const dictionary = targetLanguage === "en" ? zhToEn : enToZh;
		const translated = dictionary.get(trimmed);
		if (translated) return value.replace(trimmed, translated);

		// Translate complete labels inside known UI formats, never arbitrary substrings.
		if (trimmed.startsWith("#")) {
			return value.replace(/(#\s*)([^#]+?)(?=\s*#|$)/g,
				(_, prefix, label) => prefix + translateValue(label, targetLanguage));
		}
		const count = trimmed.match(/^(\d[\d,.]*)(\s*)(字|words?|篇文章|posts?|分鐘|minutes?|天|days?)$/);
		if (count) {
			const [, amount, gap, unit] = count;
			const englishUnit = /^(字|words?)$/.test(unit) ? "word" : /^(篇文章|posts?)$/.test(unit) ? "post" : /^(分鐘|minutes?)$/.test(unit) ? "minute" : "day";
			const nextUnit = targetLanguage === "en"
				? englishUnit + (Number(amount.replaceAll(",", "")) === 1 ? "" : "s")
				: { word: "字", post: "篇文章", minute: "分鐘", day: "天" }[englishUnit];
			return value.replace(trimmed, amount + (gap || " ") + nextUnit);
		}
		const calendar = trimmed.match(/^(\d{4})年\s*(\d{1,2})月$/);
		if (targetLanguage === "en" && calendar) return value.replace(trimmed, `${calendar[1]} / ${calendar[2]}`);
		const englishCalendar = trimmed.match(/^(\d{4}) \/ (\d{1,2})$/);
		if (targetLanguage !== "en" && englishCalendar) return value.replace(trimmed, `${englishCalendar[1]}年 ${englishCalendar[2]}月`);
		const label = trimmed.match(/^(View all posts (?:in the |with the |tagged with ))(.+?)( category| tag)?$/);
		if (label) return value.replace(trimmed, label[1] + translateValue(label[2], targetLanguage) + (label[3] || ""));
		// Browser titles combine a page name and the site name in one text node.
		if (trimmed.includes(" - ")) return value.split(" - ").map(part => dictionary.get(part.trim()) ? translateValue(part, targetLanguage) : part).join(" - ");
		return value;
	}

	// 讓會自行更新文字的元件（例如打字機）能在動畫開始前取得正確語言。
	window.mizukiTranslateValue = translateValue;
	window.mizukiGetLanguage = () => currentLanguage;

	function translateNode(root, targetLanguage) {
		if (root.nodeType === Node.TEXT_NODE) {
			const parent = root.parentElement;
			if (!parent || ignoredElements.has(parent.tagName) || parent.closest("[data-no-translate]")) return;
			const translated = translateValue(root.nodeValue || "", targetLanguage);
			if (root.nodeValue !== translated) root.nodeValue = translated;
			return;
		}

		if (!(root instanceof Element) && root !== document.body) return;
		if (root instanceof Element && (ignoredElements.has(root.tagName) || root.closest("[data-no-translate]"))) return;

		const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
		let textNode;
		while ((textNode = walker.nextNode())) {
			const parent = textNode.parentElement;
			if (!parent || ignoredElements.has(parent.tagName) || parent.closest("[data-no-translate]")) continue;
			const translated = translateValue(textNode.nodeValue || "", targetLanguage);
			if (textNode.nodeValue !== translated) textNode.nodeValue = translated;
		}

		const elements = root instanceof Element ? [root, ...root.querySelectorAll("*")] : root.querySelectorAll("*");
		for (const element of elements) {
			if (ignoredElements.has(element.tagName) || element.closest("[data-no-translate]")) continue;
			for (const attribute of ["aria-label", "title", "placeholder", "alt"]) {
				if (element.hasAttribute(attribute)) {
					const original = element.getAttribute(attribute) || "";
					const translated = translateValue(original, targetLanguage);
					if (original !== translated) element.setAttribute(attribute, translated);
				}
			}
		}
	}

	function updateSwitch() {
		const button = document.getElementById("language-switch");
		const label = document.getElementById("language-switch-label");
		if (!button || !label) return;
		const isEnglish = currentLanguage === "en";
		const nextLabel = isEnglish ? "繁中" : "EN";
		if (label.textContent !== nextLabel) label.textContent = nextLabel;
		const action = isEnglish ? "切換至繁體中文" : "Switch to English";
		for (const attribute of ["aria-label", "title", "alt"]) {
			if (button.getAttribute(attribute) !== action) button.setAttribute(attribute, action);
		}
	}

	function applyLanguage(language) {
		currentLanguage = language;
		isApplyingLanguage = true;
		document.documentElement.lang = language === "en" ? "en" : "zh-TW";
		translateNode(document.body, language);
		document.title = translateValue(document.title, language);
		updateSwitch();
		isApplyingLanguage = false;
		document.dispatchEvent(
			new CustomEvent("mizuki:language-changed", { detail: { language } }),
		);
	}

	function bindSwitch() {
		const button = document.getElementById("language-switch");
		if (!button || button.dataset.languageSwitchBound === "true") return;
		button.dataset.languageSwitchBound = "true";
		button.addEventListener("click", () => {
			const nextLanguage = currentLanguage === "en" ? "zh_TW" : "en";
			localStorage.setItem(STORAGE_KEY, nextLanguage);
			applyLanguage(nextLanguage);
		});
	}

	const languageObserver = new MutationObserver((mutations) => {
		if (isApplyingLanguage) return;
		isApplyingLanguage = true;
		for (const mutation of mutations) {
			if (mutation.type === "characterData" || mutation.type === "attributes") translateNode(mutation.target, currentLanguage);
			for (const node of mutation.addedNodes) translateNode(node, currentLanguage);
		}
		updateSwitch();
		isApplyingLanguage = false;
	});

	function initializeLanguageSwitch() {
		bindSwitch();
		applyLanguage(currentLanguage);
		if (document.body && !document.body.dataset.languageObserverActive) {
			document.body.dataset.languageObserverActive = "true";
			languageObserver.observe(document.documentElement, {
				childList: true, subtree: true, characterData: true,
				attributes: true, attributeFilter: ["aria-label", "title", "placeholder", "alt"],
			});
		}
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initializeLanguageSwitch, { once: true });
	} else {
		initializeLanguageSwitch();
	}
	document.addEventListener("swup:contentReplaced", () => applyLanguage(currentLanguage));
</script>
